# GeoRural - variáveis de ambiente
# Copie este arquivo para .env e preencha com suas credenciais.
# Nunca commite o .env.

# ---------------------------------------------------------------------------
# Google Earth Engine
# ---------------------------------------------------------------------------
GEE_PROJECT_ID=georural-project

# Diretório de credenciais OAuth criado por `earthengine authenticate`.
# O scripts/dev.py detecta automaticamente ~/.config/earthengine.
# Linux:   /home/SEU_USUARIO/.config/earthengine
# Windows: C:/Users/SEU_USUARIO/.config/earthengine
# GEE_CREDENTIALS_DIR=

# Opcional: service account (não é o fluxo usado neste projeto)
# GEE_SERVICE_ACCOUNT={"type":"service_account",...}
# GEE_SERVICE_ACCOUNT_EMAIL=servico@projeto.iam.gserviceaccount.com

# ---------------------------------------------------------------------------
# PostgreSQL (Docker Compose)
# ---------------------------------------------------------------------------
POSTGRES_DB=georural
POSTGRES_USER=georural
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5434

# Usada quando o backend roda fora do Docker (host = localhost).
# Dentro do Docker o Compose substitui o host por `db`.
DATABASE_URL=postgresql+psycopg://georural:troque-esta-senha@localhost:5434/georural

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=8000

# ---------------------------------------------------------------------------
# Performance (opcional)
# ---------------------------------------------------------------------------
# Tamanho do chunk da inferência RF/SVM (pixels) e lote de patches da U-Net.
# INFERENCE_CHUNK_SIZE=200000
# UNET_BATCH_SIZE=8
