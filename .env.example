# GeoRural - variáveis de ambiente
# Copie este arquivo para .env e preencha com suas credenciais

# ID do projeto no Google Cloud Platform (obrigatório)
GEE_PROJECT_ID=seu-project-id-aqui

# Opcional: Service Account para deploy em nuvem
# GEE_SERVICE_ACCOUNT={"type":"service_account",...}
# GEE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
